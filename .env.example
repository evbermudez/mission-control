# Path to the Archimedes repo on disk. All git/gh commands run with this as cwd.
MC_REPO_PATH=/path/to/archimedes

# Optional: override the path to the Codex companion script.
# Default: auto-detects under ~/.claude/plugins/cache/openai-codex/codex/*/scripts/codex-companion.mjs
# MC_CODEX_COMPANION=/path/to/codex-companion.mjs

# Optional: enable whitelisted prompt-run buttons in Mission Control.
# Disabled by default; copy buttons still work.
# MC_ENABLE_PROMPT_RUNS=1

# Optional: default base for review prompts.
# MC_REVIEW_BASE=origin/staging
